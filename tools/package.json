{
  "name": "second-brain-contracts",
  "version": "0.1.0",
  "description": "Contract validation and mock API for Second Brain v1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "mock": "node mock-api.mjs",
    "validate:spool": "node validate-spool.mjs",
    "validate:openapi": "redocly lint --config redocly.yaml ../docs/openapi.yaml",
    "validate": "npm run validate:openapi && npm test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@redocly/cli": "^2.73.0"
  }
}
