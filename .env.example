# Copy values into Dokploy → your compose app → Environment.
# Never commit real secrets.

# Required. Generate with: openssl rand -hex 32
BRAIN_ADMIN_TOKEN=

# Optional. Leave empty to disable LLM card generation (heuristic cards only).
# OpenRouter is OpenAI-compatible; the server appends /chat/completions itself.
# BRAIN_LLM_BASE_URL=https://openrouter.ai/api/v1
# BRAIN_LLM_MODEL=openai/gpt-6-luna
BRAIN_LLM_BASE_URL=
BRAIN_LLM_API_KEY=
BRAIN_LLM_MODEL=
# Prompt truncation cap, in characters. Default 24000; raise only if the model
# has a large context window and cards miss details.
BRAIN_LLM_MAX_INPUT_CHARS=24000

# Optional image tag shown in /health.
BRAIN_VERSION=dev
